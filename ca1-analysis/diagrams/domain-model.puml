@startuml
top to bottom direction

skinparam classAttributeIconSize 0
hide methods

class Borrower {
  name
  borrowerCategory
  contactDetails
}

class StaffMember {
  name
  role
}

class LoanRequest {
  receivedDate
  collectionDate
  returnDate
  status
  activityDescription
  namedCollector
}

class RequestedEquipmentLine {
  requestedQuantity
}

class EquipmentType {
  name
  requiresSafetyInspection
  requiresHandlingInstructions
  requiresCoordinatorApproval
}

class EquipmentUnit {
  condition
  availabilityStatus
  fundingSource
  safetyInspectionExpiryDate
}

class EquipmentComponent {
  name
  condition
  componentStatus
}

class CollectionRecord {
  collectionDate
  actualCollectorName
}

class ReturnInspectionRecord {
  returnDate
  cleanlinessResult
  safetyResult
  maintenanceNeed
}

class DamageRecord {
  identifiedDate
  issueDescription
  usableAfterDamage
  repairRequired
}

Borrower "1" -- "0..*" LoanRequest : makes
StaffMember "0..*" -- "1..*" LoanRequest : manages
LoanRequest "1" -- "1..*" RequestedEquipmentLine : contains
RequestedEquipmentLine "0..*" -- "1" EquipmentType : requests
EquipmentType "1" -- "0..*" EquipmentUnit : categorises
EquipmentUnit "1" -- "0..*" EquipmentComponent : consists of
LoanRequest "1" -- "0..1" CollectionRecord : is fulfilled by
StaffMember "1" -- "0..*" CollectionRecord : records
CollectionRecord "0..*" -- "1..*" EquipmentUnit : records issue of
CollectionRecord "1" -- "0..1" ReturnInspectionRecord : is followed by
StaffMember "1" -- "0..*" ReturnInspectionRecord : records
ReturnInspectionRecord "0..*" -- "1..*" EquipmentUnit : inspects
ReturnInspectionRecord "1" -- "0..*" DamageRecord : identifies
DamageRecord "0..*" -- "1" EquipmentUnit : affects
@enduml
